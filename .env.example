# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# On Vercel, add the same keys under Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Neon Postgres -------------------------------------------------------
# POOLED connection (host contains "-pooler"). Used by the app at runtime;
# required for serverless functions so connections are not exhausted.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# DIRECT connection (no "-pooler"). Used only by `prisma migrate` and seeding.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Admin session / auth ------------------------------------------------
# Sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="generate-a-random-secret-with-at-least-32-characters"

# Canonical origin, used for cookie scope and absolute links.
SITE_URL="http://localhost:5173"

# --- Owner bootstrap -----------------------------------------------------
# Consumed once by `npm run admin:bootstrap` to create the single owner
# account. Remove ADMIN_INITIAL_PASSWORD from the hosted environment after
# the first successful bootstrap, then redeploy.
ADMIN_NAME="Sayed Muhammad"
ADMIN_EMAIL="sayedmuhammad.dev@gmail.com"
ADMIN_INITIAL_PASSWORD="a-temporary-password-of-at-least-12-characters"

# Label shown in your authenticator app for the mandatory TOTP code.
TOTP_ISSUER="Sayed Muhammad Portfolio"

# --- Media storage -------------------------------------------------------
# "vercel-blob" in production, "static" to disable uploads entirely.
MEDIA_PROVIDER="vercel-blob"
# Required when MEDIA_PROVIDER is vercel-blob. Vercel injects this
# automatically once a Blob store is linked to the project.
BLOB_READ_WRITE_TOKEN=""

# --- Frontend (Vite, exposed to the browser) -----------------------------
# Optional. Legacy Formspree fallback for the contact form. Leave empty to
# post submissions to the built-in /api/contact inbox instead.
VITE_CONTACT_ENDPOINT=
